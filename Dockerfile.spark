FROM eclipse-temurin:17-jre
WORKDIR /app
COPY requirements.txt .
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip && rm -rf /var/lib/apt/lists/* && pip3 install --no-cache-dir --break-system-packages -r requirements.txt
COPY src ./src
COPY data ./data
CMD ["python3", "-m", "src.pipelines.gold_pipeline", "--input-dir", "data/silver", "--output-dir", "data/gold"]
